{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brujula.local/contracts/insight.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "title", "observation", "interpretation", "recommendation", "evidence_refs", "unknowns", "synthetic"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "status": {"enum": ["MEASURED", "REVIEW", "UNKNOWN", "BLOCKED"]},
    "title": {"type": "string", "minLength": 1},
    "observation": {"type": "string", "minLength": 1},
    "interpretation": {"type": "string", "minLength": 1},
    "recommendation": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unknowns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "synthetic": {"type": "boolean"}
  }
}
