{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brujula.local/contracts/analysis-v2.schema.json",
  "title": "Brújula Laboral MX sanitized analytical packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_manifest", "record_index", "profiles", "coverage", "comparisons", "claims", "opening_claim_ids", "limitations", "content_digest"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "source_manifest": {"type": "object", "additionalProperties": false,
      "required": ["acceptance", "sources"],
      "properties": {
        "acceptance": {"type": "object", "additionalProperties": false,
          "required": ["status", "numeric_content_digest", "metric_manifest_sha256", "code_sha256", "snapshots"],
          "properties": {
            "status": {"const": "PASS"}, "numeric_content_digest": {"$ref": "#/$defs/hash"},
            "metric_manifest_sha256": {"$ref": "#/$defs/hash"},
            "code_sha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}},
            "snapshots": {"type": "object", "minProperties": 8, "maxProperties": 8,
              "additionalProperties": {"type": "object", "additionalProperties": false,
                "required": ["public_content_sha256", "numeric_digest", "requested_count"],
                "properties": {"public_content_sha256": {"$ref": "#/$defs/hash"}, "numeric_digest": {"$ref": "#/$defs/hash"},
                  "requested_count": {"type": "integer", "minimum": 0}}}}
          }},
        "sources": {"type": "object", "minProperties": 8, "maxProperties": 8,
          "additionalProperties": {"type": "object", "additionalProperties": false,
            "required": ["period_id", "sha256", "url", "method_version"],
            "properties": {"period_id": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"},
              "url": {"type": "string"}, "method_version": {"type": "string"}}}}
      }},
    "record_index": {"type": "object", "minProperties": 1,
      "patternProperties": {"^v2r:[0-9a-f]{64}$": {"$ref": "#/$defs/record_item"}},
      "additionalProperties": false},
    "profiles": {"type": "object", "additionalProperties": false,
      "required": ["accepted_numeric_digest", "population_labels", "periods", "metric_ids", "national", "latest_fields", "latest_states", "latest_recorded_sexes", "latest_named_field_count", "synthetic"],
      "properties": {
        "accepted_numeric_digest": {"$ref": "#/$defs/hash"},
        "population_labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "periods": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "string"}},
        "metric_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "national": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
        "latest_fields": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
        "latest_states": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
        "latest_recorded_sexes": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
        "latest_named_field_count": {"type": "integer", "minimum": 0},
        "synthetic": {"type": "boolean"}
      }},
    "coverage": {"type": "object", "additionalProperties": false,
      "required": ["expected_cells", "missing_reasons", "suppressed_cells"],
      "properties": {"expected_cells": {"type": "object", "additionalProperties": false,
        "required": ["national", "latest_fields", "latest_states", "latest_recorded_sexes"],
        "properties": {"national": {"type": "integer"}, "latest_fields": {"type": "integer"},
          "latest_states": {"type": "integer"}, "latest_recorded_sexes": {"type": "integer"}}},
        "missing_reasons": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "suppressed_cells": {"type": "integer", "minimum": 0}}},
    "comparisons": {"type": "array", "items": {"$ref": "#/$defs/comparison"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "opening_claim_ids": {"type": "array", "maxItems": 3,
      "items": {"type": "string", "pattern": "^v2k:[0-9a-f]{64}$"}, "uniqueItems": true},
    "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "content_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_number": {"type": ["number", "null"]},
    "record_item": {"type": "object", "additionalProperties": false,
      "required": ["record_id", "grain", "record", "snapshot_sha256", "method_version", "display"],
      "properties": {"record_id": {"type": "string"}, "grain": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "string"}},
        "record": {"$ref": "#/$defs/public_record"}, "snapshot_sha256": {"$ref": "#/$defs/hash"},
        "method_version": {"type": "string"}, "redaction_reason": {"const": "complementary_suppression"},
        "display": {"type": "object", "additionalProperties": false,
          "required": ["field", "population", "metric", "geography", "recorded_sex", "period"],
          "properties": {"field": {"type": "string"}, "population": {"type": "string"},
            "metric": {"type": "string"}, "geography": {"type": "string"},
            "recorded_sex": {"type": "string"}, "period": {"type": "string"}}}}},
    "public_record": {"type": "object", "additionalProperties": false,
      "required": ["source_snapshot_id", "population_id", "field_of_study_id", "occupation_id", "industry_id", "geography_id", "recorded_sex_id", "period_id", "metric_id", "method_id", "unit", "price_basis", "method_version", "design_id", "sample_size", "weighted_denominator", "support", "precision", "status", "reason", "value", "evidence_refs", "synthetic"],
      "properties": {
        "source_snapshot_id": {"type": "string"}, "population_id": {"type": "string"},
        "field_of_study_id": {"type": "string"}, "occupation_id": {"type": "string"},
        "industry_id": {"type": "string"}, "geography_id": {"type": "string"},
        "recorded_sex_id": {"type": "string"}, "period_id": {"type": "string"},
        "metric_id": {"type": "string"}, "method_id": {"type": "string"},
        "unit": {"enum": ["people", "percent", "MXN/month", "hours/week"]},
        "price_basis": {"enum": ["nominal", "not_applicable"]},
        "method_version": {"type": "string"}, "design_id": {"type": "string"},
        "sample_size": {"type": "integer", "minimum": 0},
        "weighted_denominator": {"$ref": "#/$defs/nullable_number"},
        "support": {"type": "object", "additionalProperties": false,
          "required": ["n_psu_design", "n_strata_design", "n_psu_domain", "n_strata_domain", "design_df", "weighted_support_total"],
          "properties": {"n_psu_design": {"type": "integer"}, "n_strata_design": {"type": "integer"},
            "n_psu_domain": {"type": "integer"}, "n_strata_domain": {"type": "integer"},
            "design_df": {"type": "integer"}, "weighted_support_total": {"$ref": "#/$defs/nullable_number"}}},
        "precision": {"type": "object", "additionalProperties": false,
          "required": ["standard_error", "coefficient_variation", "ci90_lower", "ci90_upper", "method", "ci_method", "level", "singleton_policy", "official_precision"],
          "properties": {"standard_error": {"$ref": "#/$defs/nullable_number"},
            "coefficient_variation": {"$ref": "#/$defs/nullable_number"},
            "ci90_lower": {"$ref": "#/$defs/nullable_number"}, "ci90_upper": {"$ref": "#/$defs/nullable_number"},
            "method": {"type": "string"}, "ci_method": {"type": "string"}, "level": {"type": "number"},
            "singleton_policy": {"type": "string"}, "official_precision": {"type": "boolean"}}},
        "status": {"enum": ["MEASURED", "REVIEW", "UNKNOWN", "BLOCKED"]},
        "reason": {"type": ["string", "null"]}, "value": {"$ref": "#/$defs/nullable_number"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "synthetic": {"type": "boolean"}}},
    "cell": {"type": "object", "additionalProperties": false,
      "required": ["record_id", "grain", "value", "status", "reason", "sample_size", "support", "precision", "weighted_denominator_estimate", "source_sha256", "method_version", "evidence_refs", "synthetic", "source_snapshot_id", "population_id", "field_of_study_id", "occupation_id", "industry_id", "geography_id", "recorded_sex_id", "period_id", "metric_id", "method_id", "coverage"],
      "properties": {
        "record_id": {"type": "string"}, "grain": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "string"}},
        "value": {"$ref": "#/$defs/nullable_number"}, "status": {"type": "string"},
        "reason": {"type": ["string", "null"]}, "sample_size": {"type": "integer"},
        "support": {"$ref": "#/$defs/public_record/properties/support"},
        "precision": {"$ref": "#/$defs/public_record/properties/precision"},
        "weighted_denominator_estimate": {"$ref": "#/$defs/nullable_number"},
        "source_sha256": {"$ref": "#/$defs/hash"}, "method_version": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}, "synthetic": {"type": "boolean"},
        "source_snapshot_id": {"type": "string"}, "population_id": {"type": "string"},
        "field_of_study_id": {"type": "string"}, "occupation_id": {"type": "string"},
        "industry_id": {"type": "string"}, "geography_id": {"type": "string"},
        "recorded_sex_id": {"type": "string"}, "period_id": {"type": "string"},
        "metric_id": {"type": "string"}, "method_id": {"type": "string"},
        "field_label": {"type": "string"},
        "coverage": {"type": "object", "additionalProperties": false,
          "required": ["observed_n", "metric_eligible_n", "metric_exclusions", "responding_resident_n", "population_eligible_n", "exclusions", "observed_category_counts", "counts_nonexclusive", "denominator_keys", "metric_id"],
          "properties": {"observed_n": {"type": "integer"}, "metric_eligible_n": {"type": "integer"},
            "metric_exclusions": {"type": "object", "additionalProperties": {"type": "integer"}},
            "responding_resident_n": {"type": "integer"}, "population_eligible_n": {"type": "integer"},
            "exclusions": {"type": "object", "additionalProperties": {"type": "integer"}},
            "observed_category_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
            "counts_nonexclusive": {"const": true},
            "denominator_keys": {"type": "object", "additionalProperties": {"type": "string"}},
            "metric_id": {"type": "string"},
            "exact_income_response": {"type": "object", "additionalProperties": false,
              "required": ["responding_n", "denominator_n", "observed_percent", "reason", "denominator_key"],
              "properties": {"responding_n": {"type": "integer"}, "denominator_n": {"type": "integer"},
                "observed_percent": {"$ref": "#/$defs/nullable_number"},
                "reason": {"type": ["string", "null"]}, "denominator_key": {"const": "occupied_eligible_n"}}}}}}},
    "comparison": {"type": "object", "additionalProperties": false,
      "required": ["comparison_id", "previous_record_id", "current_record_id", "status", "comparable", "absolute_change", "relative_change_pct", "display_unit", "reasons", "limitations", "evidence_refs", "source_snapshot_ids", "source_sha256s", "signature_previous", "signature_current", "comparison_type", "slot_periods"],
      "properties": {
        "comparison_id": {"type": "string", "pattern": "^v2c:[0-9a-f]{64}$"},
        "previous_record_id": {"type": ["string", "null"]},
        "current_record_id": {"type": ["string", "null"]},
        "status": {"enum": ["REVIEW", "BLOCKED"]}, "comparable": {"type": "boolean"},
        "absolute_change": {"$ref": "#/$defs/nullable_number"},
        "relative_change_pct": {"$ref": "#/$defs/nullable_number"},
        "display_unit": {"type": ["string", "null"]},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "source_snapshot_ids": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": ["string", "null"]}},
        "source_sha256s": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": ["string", "null"]}},
        "signature_previous": {"type": "object"}, "signature_current": {"type": "object"},
        "comparison_type": {"enum": ["adjacent_quarter", "like_quarter_annual", "recorded_sex_slice", "entity_slice"]},
        "slot_periods": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}
      }},
    "claim": {"type": "object", "additionalProperties": false,
      "required": ["claim_id", "kind", "subject_id", "comparison_id", "record_ids", "grain", "source_snapshot_ids", "source_sha256s", "evidence_refs", "method_ids", "method_versions", "population_id", "metric_id", "precision_statuses", "sample_sizes", "quantities", "title", "observation", "interpretation", "limitation", "synthetic"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^v2k:[0-9a-f]{64}$"},
        "kind": {"enum": ["observation", "qoq", "yoy", "sex", "entity"]},
        "subject_id": {"type": "string"}, "comparison_id": {"type": ["string", "null"]},
        "record_ids": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string"}},
        "grain": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
        "source_snapshot_ids": {"type": "array", "items": {"type": "string"}},
        "source_sha256s": {"type": "array", "items": {"$ref": "#/$defs/hash"}},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "method_ids": {"type": "array", "items": {"type": "string"}},
        "method_versions": {"type": "array", "items": {"type": "string"}},
        "population_id": {"type": "string"}, "metric_id": {"type": "string"},
        "precision_statuses": {"type": "array", "items": {"type": "string"}},
        "sample_sizes": {"type": "array", "items": {"type": ["integer", "null"]}},
        "quantities": {"type": "object", "additionalProperties": {"type": ["number", "string"]}},
        "title": {"type": "string"}, "observation": {"type": "string"},
        "interpretation": {"type": "string"}, "limitation": {"type": "string"},
        "synthetic": {"type": "boolean"}}}
  }
}
